# База данных (используется сервисом database и бэкендом)
POSTGRES_DB=films
POSTGRES_USER=film
POSTGRES_PASSWORD=film

# Бэкенд
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://film:film@database:5432/films
NODE_ENV=production
# Формат логов: dev | json | tskv
LOGGER=json

# pgAdmin (http://localhost:8080)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
